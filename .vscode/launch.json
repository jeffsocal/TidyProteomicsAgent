{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TidyProteomicsAgent Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "--disable-extensions",
        "--disable-restore-windows"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js"
      ],
      "preLaunchTask": "Compile Extension"
    }
  ]
}
